# 复制为 .env 后按需修改（不要提交 .env）
# MySQL：先在本机创建空库，例如：
#   CREATE DATABASE venture_management DEFAULT CHARACTER SET utf8 COLLATE utf8_general_ci;

MYSQL_HOST=127.0.0.1
MYSQL_DATABASE=venture_management
MYSQL_USER=root
MYSQL_PASSWORD=

# 首次本地跑：设为 1 可在连接成功后自动 sequelize.sync() 建表（仅开发环境）
SYNC_DB=1

# 后端 API 端口（与 config/index.js 里 dev.proxyTable 的 target 端口一致）
API_PORT=8081
